# --- the three data sources ---
FOOTBALL_DATA_KEY=          # football-data.org (goal model for 10 leagues)
ODDS_API_KEY=               # the-odds-api.com (odds, many leagues, basketball)
ODDSPAPI_KEY=               # oddspapi.io (Pinnacle prices, corners, shots)
ODDSPAPI_BOOKMAKERS=pinnacle
# --- tuning ---
THEODDSAPI_REGIONS=eu       # each extra region costs extra credits
ODDS_CACHE_SECONDS=21600    # 6 h: keeps the 500 free credits/month going
ODDS_API_MIN_CREDITS=20     # stop spending credits below this
MODEL_WEIGHT=0.6            # football-data leagues: own model vs market
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=               # Postgres (Neon) for the results log; empty = local SQLite
